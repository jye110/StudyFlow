# Local development uses SQLite if DATABASE_URL is absent.
# Docker Compose reads this file. For local shells, export the values you need.
DATABASE_URL=mysql+pymysql://studyflow:CHANGE_ME@127.0.0.1:3306/studyflow
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
APP_ENV=development
ALLOWED_ORIGIN=http://127.0.0.1:5173
# Optional: both values are required to enable live AI.
OPENAI_API_KEY=
OPENAI_MODEL=
# Production only, behind the supplied TLS reverse proxy:
# APP_ENV=production
# PUBLIC_ORIGIN=https://studyflow.example.edu
# SITE_HOST=studyflow.example.edu
